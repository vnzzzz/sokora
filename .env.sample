SERVICE_PORT=
VERSION=
proxy=
NO_PROXY=localhost,127.0.0.1

# Production container runtime
PORT=8000

# Application runtime
SOKORA_LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/sokora.db
# PostgreSQL example:
# DATABASE_URL=postgresql://sokora:password@db.example:5432/sokora?sslmode=require

# 認証設定
SOKORA_AUTH_SESSION_SECRET=
SOKORA_AUTH_ENABLED=false
SOKORA_AUTH_SESSION_TTL_SECONDS=3600
# HTTPS productionではtrueにする
SOKORA_AUTH_SESSION_HTTPS_ONLY=false
SOKORA_LOCAL_AUTH_ENABLED=true
SOKORA_LOCAL_ADMIN_USERNAME=
SOKORA_LOCAL_ADMIN_PASSWORD=

# OIDC設定（Keycloak等。endpointはissuer discoveryから取得）
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_SCOPES=openid profile email
OIDC_HTTP_TIMEOUT=3.0
