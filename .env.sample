SERVICE_PORT=
VERSION=
proxy=

# Application runtime
SOKORA_LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/sokora.db

# 認証設定
SOKORA_AUTH_SESSION_SECRET=
SOKORA_AUTH_ENABLED=false
SOKORA_AUTH_SESSION_TTL_SECONDS=3600
SOKORA_LOCAL_AUTH_ENABLED=true
SOKORA_LOCAL_ADMIN_USERNAME=
SOKORA_LOCAL_ADMIN_PASSWORD=
SOKORA_AUTH_STATE_PATH=

# OIDC (Keycloak) 設定
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_SCOPES=openid profile email
OIDC_HTTP_TIMEOUT=3.0
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_USERINFO_ENDPOINT=
OIDC_LOGOUT_ENDPOINT=
