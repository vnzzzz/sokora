# Local Make workflow
# Host port used by `make run` / `make docker-run`.
SERVICE_PORT=8000
# Required only by versioned image/package targets such as docker-build/docker-run/closed-bundle.
# VERSION=dev

# Optional Docker build/runtime proxy.
# proxy=http://proxy.example:8080
NO_PROXY=localhost,127.0.0.1

# Production container runtime
PORT=8000

# Application runtime
SOKORA_LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/sokora.db
# PostgreSQL example:
# DATABASE_URL=postgresql://sokora:password@db.example:5432/sokora?sslmode=require

# 認証設定
# 認証guardまたはlocal adminを利用する場合は固定のランダム値を明示設定する。
# 例: openssl rand -hex 32
SOKORA_AUTH_SESSION_SECRET=
SOKORA_AUTH_ENABLED=false
SOKORA_AUTH_SESSION_TTL_SECONDS=3600
# HTTPS productionではtrueにする
SOKORA_AUTH_SESSION_HTTPS_ONLY=false
SOKORA_LOCAL_AUTH_ENABLED=true
SOKORA_LOCAL_ADMIN_USERNAME=
SOKORA_LOCAL_ADMIN_PASSWORD=

# DB-backed OIDC client secret用の外部Fernet鍵。全replicaで同一値を設定する。
# legacy env-only OIDCのままなら未設定でもよい。
SOKORA_AUTH_CONFIG_ENCRYPTION_KEY=

# OIDC runtime control。DB-backed / legacy env-onlyの両方で使用する。
OIDC_REDIRECT_URL=
OIDC_HTTP_TIMEOUT=3.0

# Legacy env-only OIDC fallback。
# auth_config rowが未作成のruntimeでだけissuer/client/scope sourceとして使用する。
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
