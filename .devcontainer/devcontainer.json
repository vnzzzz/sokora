{
  "name": "sokora-dev",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--name",
    "sokora-dev",
    "--add-host",
    "keycloak.localhost:host-gateway"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind,consistency=cached",
  "workspaceFolder": "/app",
  "mounts": [
    "source=sokora-data,target=/app/data,type=volume",
    "source=sokora-poetry-cache,target=/home/vscode/.cache/pypoetry,type=volume"
  ],
  "features": {
    "ghcr.io/vnzzzz/agentic-development-toolkit/agent-dev:1": {}
  },
  "postStartCommand": "bash .devcontainer/ensure-volume-ownership.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "[html]": {
          "editor.formatOnSave": false
        },
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "python.formatting.provider": "black",
        "python.linting.enabled": true,
        "python.linting.mypyEnabled": true,
        "python.linting.flake8Enabled": true,
        "python.sortImports.args": [
          "--profile",
          "black"
        ]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "matangover.mypy",
        "njpwerner.autodocstring",
        "tamasfe.even-better-toml",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ecmel.vscode-html-css",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions"
      ]
    }
  },
  "remoteUser": "vscode"
}
