# Application runtime settings. Store the real file outside the deployment bundle,
# for example /etc/sokora/runtime.env, and restrict its permissions.
SOKORA_LOG_LEVEL=INFO

# Leave blank in the template. The SQLite compose adapter overrides DATABASE_URL
# to sqlite:///data/sokora.db. PostgreSQL deployments must set a PostgreSQL URL;
# compose.postgresql.yaml rejects missing or non-PostgreSQL values before startup.
DATABASE_URL=

# Authentication/session settings. Blank is valid only while authentication is
# disabled. Before setting SOKORA_AUTH_ENABLED=true, inject an explicit secret;
# blank/whitespace and the public development default are rejected at startup.
SOKORA_AUTH_SESSION_SECRET=
SOKORA_AUTH_ENABLED=false
SOKORA_AUTH_SESSION_TTL_SECONDS=3600
# HTTPS production should use true.
SOKORA_AUTH_SESSION_HTTPS_ONLY=false
SOKORA_LOCAL_AUTH_ENABLED=true
SOKORA_LOCAL_ADMIN_USERNAME=
SOKORA_LOCAL_ADMIN_PASSWORD=

# OIDC settings. Endpoints are discovered from OIDC_ISSUER.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_SCOPES=openid profile email
OIDC_HTTP_TIMEOUT=3.0

# Optional runtime proxy settings. Add internal DB/OIDC endpoints to NO_PROXY when needed.
# HTTP_PROXY=http://proxy.example:8080
# HTTPS_PROXY=http://proxy.example:8080
# http_proxy=http://proxy.example:8080
# https_proxy=http://proxy.example:8080
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1
