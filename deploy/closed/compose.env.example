# Deployment-only values consumed by Docker Compose.
# package_closed_bundle.sh replaces __SOKORA_IMAGE__ with the packaged image tag.
SOKORA_IMAGE=__SOKORA_IMAGE__
SERVICE_PORT=8000
PORT=8000

# SQLite only. Keep mutable data outside the deployment bundle lifecycle.
SOKORA_DATA_DIR=/var/lib/sokora

# Keep secrets/runtime settings outside the deployment bundle lifecycle.
SOKORA_RUNTIME_ENV_FILE=/etc/sokora/runtime.env
